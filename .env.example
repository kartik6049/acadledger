# Copy to .env and change JWT_SECRET
# Hostnames below are the docker compose service names.

DATABASE_URL=
REDIS_URL=

STORAGE_BACKEND=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

JWT_SECRET=
JWT_EXPIRE_MINUTES=
# Set to true once the app is served over HTTPS.
COOKIE_SECURE=

# Which ApaarClient implementation to use. Only "mock" exists today.
APAAR_CLIENT=

# Password given to every account created by `python -m app.seed` (dev only).
SEED_PASSWORD=
