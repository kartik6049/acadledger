# Copy to .env and change JWT_SECRET (e.g. `openssl rand -hex 32`).
# Hostnames below are the docker compose service names.

DATABASE_URL=postgresql+psycopg://acadledger:acadledger@db:5432/acadledger
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=acadledger
S3_SECRET_KEY=acadledger-minio
S3_BUCKET=acadledger-uploads

JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
# Set to true once the app is served over HTTPS.
COOKIE_SECURE=false

# Which ApaarClient implementation to use. Only "mock" exists today.
APAAR_CLIENT=mock

# Password given to every account created by `python -m app.seed` (dev only).
SEED_PASSWORD=acadledger-demo-1
